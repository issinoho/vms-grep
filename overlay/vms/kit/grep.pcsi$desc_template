--
-- PCSI product description for GNU grep on OpenVMS.
-- Template: tools/prepare.sh substitutes @PRODUCER@, @BASE@ and @PCSIVERSION@.
--
product @PRODUCER@ @BASE@ GREP @PCSIVERSION@ full ;

    information RELEASE_NOTES phase after ;

    directory [GREP] ;
    directory [GREP.BIN] ;
    directory [GREP.DOC] ;

    file [GREP.BIN]GREP.EXE ;
    file [SYS$STARTUP]GREP$STARTUP.COM ;
    file [GREP]GREP$SETUP.COM ;
    file [GREP.DOC]README.VMS ;
    file [GREP.DOC]COPYING. ;
    file [GREP.DOC]NEWS. ;
    file [GREP.DOC]GREP.TXT ;
    file [GREP.DOC]GREP.1 ;

    -- Define GREP$ROOT now and print the post-installation tasks (PCSI shows
    -- only the title of an information message unless /HELP is given).
    execute postinstall "@PCSI$DESTINATION:[SYS$STARTUP]GREP$STARTUP.COM INSTALL" interactive ;
    -- On removal, deassign GREP$ROOT.
    execute install "CONTINUE" remove "@PCSI$DESTINATION:[SYS$STARTUP]GREP$STARTUP.COM REMOVE" ;

    information POST_INSTALL phase after ;

end product ;
