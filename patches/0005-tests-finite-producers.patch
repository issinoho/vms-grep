Subject: tests: avoid 'yes | head' style pipelines

VMS pipes do not deliver SIGPIPE, so an endless producer such as yes(1)
blocks forever once its consumer exits.  Generate the same N lines with
a finite seq | sed pipeline instead.

--- a/tests/null-byte	2026-10-02 22:20:38.051458105 +0100
+++ b/tests/null-byte	2026-10-02 22:20:38.081480926 +0100
@@ -51,7 +51,7 @@
   done
 done
 
-(echo xxx && yes yyy | head -n 100000 && printf 'z\n\0') >in || framework_failure_
+(echo xxx && seq 100000 | sed "s/.*/yyy/" && printf 'z\n\0') >in || framework_failure_
 echo xxx >exp || framework_failure_
 grep xxx in >out || fail=1
 compare exp out || fail=1
--- a/tests/write-error-msg	2026-10-02 22:20:38.055210023 +0100
+++ b/tests/write-error-msg	2026-10-02 22:20:38.081572043 +0100
@@ -23,7 +23,7 @@
 
 # generate large input, filling the libc stdio buffers
 # and triggering a write(2) even without line buffering.
-yes 12345 | head -n 50000 > in || framework_failure_
+seq 50000 | sed "s/.*/12345/" > in || framework_failure_
 
 fail=0
 
--- a/tests/mb-non-UTF8-performance	2026-10-02 22:20:38.058717617 +0100
+++ b/tests/mb-non-UTF8-performance	2026-10-02 22:20:38.081645177 +0100
@@ -32,7 +32,7 @@
 # the unibyte test takes at least 10ms of user time.
 n_lines=100000
 while :; do
-  yes $(printf '%078d' 0) | sed ${n_lines}q > in || framework_failure_
+  seq ${n_lines} | sed "s/.*/$(printf '%078d' 0)/" > in || framework_failure_
   ubyte_ms=$(LC_ALL=C user_time_ 1 grep -i foobar in) || fail=1
   test $ubyte_ms -ge 10 && break
   n_lines=$(expr $n_lines + 200000)
--- a/tests/mb-non-UTF8-perf-Fw	2026-10-02 22:20:38.062015100 +0100
+++ b/tests/mb-non-UTF8-perf-Fw	2026-10-02 22:20:38.081708877 +0100
@@ -23,7 +23,7 @@
 require_timeout_
 require_JP_EUC_locale_
 
-yes 00 | head -n 10000000 > in || framework_failure_
+seq 10000000 | sed "s/.*/00/" > in || framework_failure_
 
 # Since we're using an absolute timeout below and want to avoid any initial
 # disk read performance penalty, run first with a large timeout and no error
