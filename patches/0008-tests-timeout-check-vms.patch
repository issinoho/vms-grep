Subject: tests: check timeout with whole seconds on OpenVMS

Process creation on VMS takes much longer than the 10ms that
require_timeout_ allows, so the check failed and 15 tests were skipped.

--- a/tests/init.cfg	2026-10-03 01:25:04.433476101 +0100
+++ b/tests/init.cfg	2026-10-03 01:25:04.456173945 +0100
@@ -42,8 +42,16 @@
     || skip_ your system lacks the timeout program
   returns_ 1 timeout 10s false \
     || skip_ your system has a non-GNU timeout program
-  returns_ 124 timeout 0.01 sleep 0.02 \
-    || skip_ "'timeout 0.01 sleep 0.02' did not time out"
+  # On OpenVMS, creating the child takes far longer than 10ms and GNV's
+  # timeout cannot interrupt it while it starts; check with whole seconds.
+  case $(uname -s 2>/dev/null) in
+    OpenVMS)
+      returns_ 124 timeout 1 sleep 5 \
+        || skip_ "'timeout 1 sleep 5' did not time out" ;;
+    *)
+      returns_ 124 timeout 0.01 sleep 0.02 \
+        || skip_ "'timeout 0.01 sleep 0.02' did not time out" ;;
+  esac
 }
 
 require_pcre_()
